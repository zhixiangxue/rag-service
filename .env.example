# ============================================
# Environment Variables for RAG Service
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# API Keys
# ============================================
# Each provider key is required when its URI prefix matches:
#   EMBEDDING_URI=bailian/...  → BAILIAN_API_KEY
#   LLM_URI=deepseek/...       → DEEPSEEK_API_KEY
#   RERANKER_URI=bailian/...   → BAILIAN_API_KEY
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
BAILIAN_API_KEY=your_bailian_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# ============================================
# Infrastructure Services Auth
# ============================================
# Infra services are installed via scripts/infra.sh --install, which prompts
# for a shared password interactively (or reads INFRA_PASSWORD env var).
# If a password was set, configure the SAME value in the client-side vars:
#   VECTOR_STORE_API_KEY / MEILISEARCH_API_KEY / DATABASE_URI (user rag) / REDIS_PASSWORD

# ============================================
# Database Configuration
# ============================================
# SQLite (single-node / dev)
# DATABASE_URI=sqlite:///./rag_service.db
# rqlite (shared network database for multi-node deployments)
# With INFRA_PASSWORD set: DATABASE_URI=http://rag:<INFRA_PASSWORD>@localhost:4001
DATABASE_URI=http://localhost:4001

# ============================================
# Vector Store Configuration
# ============================================
VECTOR_STORE_TYPE=qdrant
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=16333
VECTOR_STORE_GRPC_PORT=16334
# Set to the infra password if Qdrant was installed with auth
# VECTOR_STORE_API_KEY=your_infra_password

# ============================================
# Full-Text Search Configuration
# ============================================
MEILISEARCH_HOST=http://localhost:7700
# Set to the same value as INFRA_PASSWORD if infra.sh installed with auth
# MEILISEARCH_API_KEY=your_meilisearch_api_key

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6380
# Set to the infra password if Redis was installed with auth (requirepass)
# REDIS_PASSWORD=your_infra_password

# ============================================
# Graph Database Configuration (FalkorDB)
# ============================================
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Set to the infra password if FalkorDB was installed with auth (requirepass)
# FALKORDB_PASSWORD=your_infra_password

# ============================================
# Embedding Configuration
# ============================================
# Options: openai/text-embedding-3-small, bailian/text-embedding-v3, etc.
EMBEDDING_URI=openai/text-embedding-3-small

# ============================================
# Reranker Configuration
# ============================================
# Options: bailian/gte-rerank-v2, cohere/rerank-english-v3.0, etc.
RERANKER_URI=cohere/rerank-english-v3.0

# ============================================
# LLM Configuration
# ============================================
# Options: openai/gpt-4o-mini, deepseek/deepseek-v4-pro, bailian/qwen-xxx, etc.
LLM_URI=openai/gpt-4o-mini

# ============================================
# Multimodal / Merge Model Configuration (optional)
# ============================================
# Used by PyMuPDF4LLM table enhancement (classic & LOD modes).
# When both are unset, table enhancement is automatically disabled.
#
# MULTIMODAL_MODEL_URI: vision-capable model for page-level table re-extraction.
#   Examples: bailian/qwen-vl-max, openai/gpt-4o, anthropic/claude-sonnet-4-5
# MERGE_MODEL_URI: lightweight text model for cross-page table merge decisions.
#   If unset, falls back to the same provider/key as MULTIMODAL_MODEL_URI.
#   Examples: bailian/qwen-plus, openai/gpt-4o-mini
MULTIMODAL_MODEL_URI=bailian/qwen-vl-max
# MERGE_MODEL_URI=bailian/qwen-plus

# ============================================
# File Storage Configuration
# ============================================
UPLOAD_DIR=./uploads
STORAGE_TYPE=local

# AWS S3 (if STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_KEY=your_secret_key
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1

# ============================================
# Document Processing Configuration
# ============================================
MAX_PAGES_PER_PART=100
USE_GPU=false
NUM_THREADS=8
MAX_CHUNK_TOKENS=1200
TABLE_MAX_TOKENS=1500
TARGET_TOKEN_SIZE=800
NUM_KEYWORDS=5

# PDF cache directories
PDF_FILES_DIR=~/.zag/cache/pdfs
LOCATE_CACHE_DIR=~/.zag/cache/locate_diskcache
ARCHIVES_DIR=~/.zag/cache/archives

# ============================================
# API Server Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

# Service-level access key for all endpoints (empty = no auth)
ACCESS_KEY=

# Enable Swagger UI and ReDoc (set to false in production)
DEV_MODE=false
